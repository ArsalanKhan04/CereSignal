# Stage 1: Build Image
FROM python:3.14-slim

# Set environment variables
ENV PYTHONUNBUFFERED 1
ENV APP_HOME /usr/src/app

# Create and set the working directory
RUN mkdir -p $APP_HOME
WORKDIR $APP_HOME

# Install dependencies.
# Set INSTALL_AI=false to build a manual-entry-only image that omits torch/openai
# (see requirements-ai.txt and the AI_INFERENCE_ENABLED setting).
ARG INSTALL_AI=true
COPY ./requirements.txt ./requirements-ai.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    if [ "$INSTALL_AI" = "true" ]; then pip install --no-cache-dir -r requirements-ai.txt; fi

# Copy the source code
COPY . .

# Railway reaches the container through its proxy, and uvicorn only trusts
# X-Forwarded-For from 127.0.0.1 by default. Without this every client has the
# proxy's address, and app/core/rate_limit.py puts them all in one bucket.
ENV FORWARDED_ALLOW_IPS="*"

# Expose the port Uvicorn runs on
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
