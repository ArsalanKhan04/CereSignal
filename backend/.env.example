# CereSignal API Configuration
#
# Defaults below are set up for LOCAL DEVELOPMENT: copy this file to .env and it runs
# as-is with no cloud account (SQLite database, uploads on local disk).
# Deployment settings are commented out further down — uncomment and fill them in
# for a real deployment.

# Project settings
PROJECT_NAME=CereSignal API
VERSION=1.0.0
API_V1_STR=/api/v1

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database
# Local dev: SQLite needs no server. sslmode=require is applied only to Postgres URLs.
DATABASE_URL=sqlite:///./cere_signal.db
#
# Deployment — use the Session Pooler URL for all connections (IPv4-compatible)
# In Supabase dashboard: Connect -> Session pooler -> copy the connection string
# Session Pooler (port 5432):  works on GitHub Actions, Railway, and local dev
# Transaction Pooler (port 6543): avoid — breaks SQLAlchemy's create_all
# Direct connection (db.xxx.supabase.co:5432): IPv6 only, won't work on GitHub Actions
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Security settings — generate with: openssl rand -hex 32
SECRET_KEY=change-me-for-local-dev
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-app.up.railway.app

# Redis — Railway provides REDIS_URL automatically for internal services
REDIS_URL=redis://localhost:6379/0

# AI/ML inference — defaults to True. Uncomment to make a manual-entry-only
# deployment the persistent default: the worker skips NeuroGate/NeuroTransformer
# and LLM report generation, and torch/openai are not required (see
# backend/requirements-ai.txt). For a single run, prefer ./scripts/*-start.sh --no-ai.
# AI_INFERENCE_ENABLED=False

# Frontend URL — used to build invite/portal links (no trailing slash)
FRONTEND_URL=http://localhost:3000

# File upload settings
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=.edf,.csv,.json,.txt

# Processing settings
MAX_CONCURRENT_PROCESSES=4
PROCESSING_TIMEOUT=300

# LLM model used for report drafting (only relevant with OPENAI_API_KEY set)
OPENAI_MODEL=gpt-4o-mini


# ---------------------------------------------------------------------------
# Deployment / optional settings — commented out so local development just works.
# ---------------------------------------------------------------------------

# File storage
# Leave SUPABASE_URL unset to store uploads on local disk under backend/local_storage/,
# served from /static. Set it to switch to Supabase Storage.
# Required buckets: eeg-signals, eeg-assets
# SUPABASE_PUBLISHABLE_KEY replaces the legacy SUPABASE_ANON_KEY (safe for client-side use)
# SUPABASE_SECRET_KEY replaces the legacy SUPABASE_SERVICE_ROLE_KEY (backend only)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# OpenAI — drafts the clinical report text. Without it inference still runs and the
# report fields are simply left blank for manual entry.
# OPENAI_API_KEY=sk-...

# Email (staff invitations, patient portal links)
# With neither option configured the link is written to the backend log instead of
# being emailed — enough to complete both flows locally.
#
# Option 1 — Resend SDK (recommended). Get an API key at https://resend.com -> API Keys
# MAIL_FROM must be a verified domain sender in Resend (e.g. noreply@yourdomain.com);
# leave blank to use the Resend sandbox address (onboarding@resend.dev) — dev only
# RESEND_API_KEY=re_...
# MAIL_FROM=noreply@yourdomain.com
#
# Option 2 — SMTP fallback (used only if RESEND_API_KEY is not set)
# Example below uses Resend's SMTP relay; swap for smtp.gmail.com:587 etc. if preferred
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_...
# MAIL_FROM=noreply@yourdomain.com
# MAIL_PORT=465
# MAIL_SERVER=smtp.resend.com
# MAIL_STARTTLS=False
# MAIL_SSL_TLS=True
