# CereSignal API Configuration

# Project settings
PROJECT_NAME=CereSignal API
VERSION=1.0.0
API_V1_STR=/api/v1

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database — use the Session Pooler URL for all connections (IPv4-compatible)
# In Supabase dashboard: Connect → Session pooler → copy the connection string
# Session Pooler (port 5432):  works on GitHub Actions, Railway, and local dev
# Transaction Pooler (port 6543): avoid — breaks SQLAlchemy's create_all
# Direct connection (db.xxx.supabase.co:5432): IPv6 only, won't work on GitHub Actions
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Security settings — generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-app.up.railway.app

# Redis — Railway provides REDIS_URL automatically for internal services
# For local dev: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase client credentials
# SUPABASE_PUBLISHABLE_KEY replaces the legacy SUPABASE_ANON_KEY (safe for client-side use)
# SUPABASE_SECRET_KEY replaces the legacy SUPABASE_SERVICE_ROLE_KEY (backend only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# File upload settings
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=.edf,.csv,.json,.txt

# Processing settings
MAX_CONCURRENT_PROCESSES=4
PROCESSING_TIMEOUT=300

# Email settings (for staff invitation emails)
# Option 1 — Resend SDK (recommended): set RESEND_API_KEY and optionally MAIL_FROM
# Get your API key at https://resend.com → API Keys
RESEND_API_KEY=re_...
# MAIL_FROM must be a verified domain sender in Resend (e.g. noreply@yourdomain.com)
# Leave blank to use the Resend sandbox address (onboarding@resend.dev) — dev only
MAIL_FROM=noreply@yourdomain.com

# Option 2 — SMTP fallback (used only if RESEND_API_KEY is not set)
# Example below uses Resend's SMTP relay; swap for smtp.gmail.com:587 etc. if preferred
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_...
# MAIL_FROM=noreply@yourdomain.com
# MAIL_PORT=465
# MAIL_SERVER=smtp.resend.com
# MAIL_STARTTLS=False
# MAIL_SSL_TLS=True

# Frontend URL — used to build invite links in emails (no trailing slash)
FRONTEND_URL=http://localhost:3000
