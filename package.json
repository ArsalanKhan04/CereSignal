{
  "name": "ceresignal-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
      "start": "electron .",
      "start:desktop": "cross-env REACT_APP_DESKTOP=true electron .",
      "build": "npm --prefix frontend run build && electron-builder --win nsis",
      "build:desktop": "powershell -ExecutionPolicy Bypass -File backend/build-desktop.ps1 && npm --prefix frontend run build:desktop && cross-env REACT_APP_DESKTOP=true electron-builder --win nsis"
    },
  "build": {
    "appId": "com.ceresignal.app",
    "productName": "CereSignal",
    "files": [
      "main.js",
      "preload.js",
      "frontend/build/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/cere-engine",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
