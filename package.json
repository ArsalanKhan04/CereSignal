{
  "name": "ceresignal-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ceresignal.app",
    "productName": "CereSignal",
    "files": [
      "main.js",
      "frontend/build/**/*" 
    ],
    "extraResources": [
      {
        "from": "resources/redis-server.exe",
        "to": "redis-server.exe"
      },
      {
        "from": "backend/dist/cere-engine",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}