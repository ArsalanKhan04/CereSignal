{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=6144 react-scripts start",
    "dev:desktop": "cross-env NODE_OPTIONS=--max-old-space-size=6144 REACT_APP_DESKTOP=true react-scripts start",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 react-scripts build",
    "build:desktop": "cross-env NODE_OPTIONS=--max-old-space-size=6144 REACT_APP_DESKTOP=true react-scripts build",
    "start": "npx --yes serve -s build -l 3000",
    "start:desktop": "npx --yes serve -s build -l 3000",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=6144 react-scripts test",
    "test:ci": "cross-env NODE_OPTIONS=--max-old-space-size=6144 CI=true react-scripts test --watchAll=false"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.12.2",
    "plotly.js-basic-dist": "^2.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-plotly.js": "^2.5.1",
    "react-router-dom": "^7.9.4",
    "react-scripts": "5.0.1",
    "recharts": "^3.3.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^axios$": "axios/dist/node/axios.cjs",
      "^plotly\\.js-basic-dist$": "<rootDir>/src/__mocks__/plotly.ts",
      "^react-plotly\\.js$": "<rootDir>/src/__mocks__/reactPlotly.tsx"
    }
  }
}
