# CereSignal API Configuration

# Project settings
PROJECT_NAME=CereSignal API
VERSION=1.0.0
API_V1_STR=/api/v1

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database — use the Session Pooler URL for all connections (IPv4-compatible)
# In Supabase dashboard: Connect → Session pooler → copy the connection string
# Session Pooler (port 5432):  works on GitHub Actions, Railway, and local dev
# Transaction Pooler (port 6543): avoid — breaks SQLAlchemy's create_all
# Direct connection (db.xxx.supabase.co:5432): IPv6 only, won't work on GitHub Actions
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Security settings — generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-app.up.railway.app

# Redis — Railway provides REDIS_URL automatically for internal services
# For local dev: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase client credentials
# SUPABASE_PUBLISHABLE_KEY replaces the legacy SUPABASE_ANON_KEY (safe for client-side use)
# SUPABASE_SECRET_KEY replaces the legacy SUPABASE_SERVICE_ROLE_KEY (backend only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# File upload settings
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=.edf,.csv,.json,.txt

# Processing settings
MAX_CONCURRENT_PROCESSES=4
PROCESSING_TIMEOUT=300
